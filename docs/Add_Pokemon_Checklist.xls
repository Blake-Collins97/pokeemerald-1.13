<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
  <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><Title>Add a Pokemon Checklist</Title><Subject>Species integration checklist for pokeemerald-1.13</Subject></DocumentProperties>
  <Styles>
    <Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Top" ss:WrapText="1"/><Font ss:FontName="Calibri" ss:Size="11"/><Interior/></Style>
    <Style ss:ID="Header"><Alignment ss:Vertical="Center" ss:WrapText="1"/><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#256B5B" ss:Pattern="Solid"/></Style>
  </Styles>
  <Worksheet ss:Name="Add Pokemon Checklist">
    <Table>
      <Column ss:Width="45"/><Column ss:Width="105"/><Column ss:Width="390"/><Column ss:Width="330"/><Column ss:Width="280"/>
      <Row ss:StyleID="Header"><Cell><Data ss:Type="String">Done</Data></Cell><Cell><Data ss:Type="String">Area</Data></Cell><Cell><Data ss:Type="String">Checklist item</Data></Cell><Cell><Data ss:Type="String">File(s)</Data></Cell><Cell><Data ss:Type="String">Notes</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Core species</Data></Cell><Cell><Data ss:Type="String">Assign a new internal SPECIES_* ID; preserve existing IDs. Check FORMS_START, SPECIES_EGG, and NUM_SPECIES.</Data></Cell><Cell><Data ss:Type="String">include/constants/species.h</Data></Cell><Cell><Data ss:Type="String">Adding before FORMS_START shifts the form IDs.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Core species</Data></Cell><Cell><Data ss:Type="String">Define stats, types, abilities, gender ratio, growth, egg groups, and other base data.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon/base_stats.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Core species</Data></Cell><Cell><Data ss:Type="String">Add the display name.</Data></Cell><Cell><Data ss:Type="String">src/data/text/species_names.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Core species</Data></Cell><Cell><Data ss:Type="String">Add a level-up learnset and register its pointer.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon/level_up_learnsets.h; src/data/pokemon/level_up_learnset_pointers.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Core species</Data></Cell><Cell><Data ss:Type="String">Add TM/HM, tutor, and egg move learnsets.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon/tmhm_learnsets.h; src/data/pokemon/tutor_learnsets.h; src/data/pokemon/egg_moves.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Core species</Data></Cell><Cell><Data ss:Type="String">Add outgoing evolution data; update the evolution source species too.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon/evolution.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Pokedex</Data></Cell><Cell><Data ss:Type="String">Assign a NATIONAL_DEX_* number. If expanding National Dex, update NATIONAL_DEX_COUNT and POKEMON_SLOTS_NUMBER.</Data></Cell><Cell><Data ss:Type="String">include/constants/species.h</Data></Cell><Cell><Data ss:Type="String">Current National Dex count ends at Calyrex (#898).</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Pokedex</Data></Cell><Cell><Data ss:Type="String">Map internal species ID to National Dex number.</Data></Cell><Cell><Data ss:Type="String">src/pokemon.c</Data></Cell><Cell><Data ss:Type="String">gSpeciesToNationalPokedexNum.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Pokedex</Data></Cell><Cell><Data ss:Type="String">Add Hoenn Dex mapping only if it belongs in the Hoenn Dex.</Data></Cell><Cell><Data ss:Type="String">src/pokemon.c</Data></Cell><Cell><Data ss:Type="String">gSpeciesToHoennPokedexNum.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Pokedex</Data></Cell><Cell><Data ss:Type="String">Add Pokedex description and entry metadata: category, dimensions, text, and sprite scales/offsets.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon/pokedex_text.h; src/data/pokemon/pokedex_entries.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Pokedex</Data></Cell><Cell><Data ss:Type="String">Add the National Dex number to alphabetical, weight, and height order arrays.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon/pokedex_orders.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Graphics</Data></Cell><Cell><Data ss:Type="String">Add front/back sprites, icon, front animation, normal and shiny palettes, and footprint assets.</Data></Cell><Cell><Data ss:Type="String">graphics/pokemon/&lt;name&gt;/</Data></Cell><Cell><Data ss:Type="String">Follow existing per-species asset folder conventions.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Graphics</Data></Cell><Cell><Data ss:Type="String">Register front/back sprites and palette tables.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon_graphics/front_pic_table.h; back_pic_table.h; palette_table.h; shiny_palette_table.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Graphics</Data></Cell><Cell><Data ss:Type="String">Add front/back sprite coordinates, footprint, and enemy elevation.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon_graphics/front_pic_coordinates.h; back_pic_coordinates.h; footprint_table.h; enemy_mon_elevation.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Graphics</Data></Cell><Cell><Data ss:Type="String">Register the party and Pokedex icon.</Data></Cell><Cell><Data ss:Type="String">src/pokemon_icon.c</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Animation</Data></Cell><Cell><Data ss:Type="String">Add front animation ID and timing, and choose a back animation.</Data></Cell><Cell><Data ss:Type="String">src/pokemon.c; src/pokemon_animation.c</Data></Cell><Cell><Data ss:Type="String">sMonFrontAnimIdsTable, sMonAnimationDelayTable, sSpeciesToBackAnimSet.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Sound</Data></Cell><Cell><Data ss:Type="String">Add a cry entry and associated cry sample data.</Data></Cell><Cell><Data ss:Type="String">sound/cry_tables.inc; sound/direct_sound_data.inc; sound/direct_sound_samples/cries/</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Sound</Data></Cell><Cell><Data ss:Type="String">Add the Bard sound pronunciation entry.</Data></Cell><Cell><Data ss:Type="String">src/data/bard_music/pokemon.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Conditional</Data></Cell><Cell><Data ss:Type="String">If gender appearance differs, register gender difference and female sprites, palettes, and icons.</Data></Cell><Cell><Data ss:Type="String">src/data.c; src/pokemon_icon.c; src/data/pokemon_graphics/</Data></Cell><Cell><Data ss:Type="String">Only for species with visible gender differences.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Conditional</Data></Cell><Cell><Data ss:Type="String">If adding alternate forms, define form IDs and form species tables/pointers.</Data></Cell><Cell><Data ss:Type="String">include/constants/species.h; src/data/pokemon/form_species_tables.h; src/data/pokemon/form_species_table_pointers.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Conditional</Data></Cell><Cell><Data ss:Type="String">If forms can change in-game, add form-change data and register pointers.</Data></Cell><Cell><Data ss:Type="String">src/data/pokemon/form_change_tables.h; src/data/pokemon/form_change_table_pointers.h</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Conditional</Data></Cell><Cell><Data ss:Type="String">If obtainable, add wild encounter, trainer party, trade, or event/script data as appropriate.</Data></Cell><Cell><Data ss:Type="String">src/data/wild_encounters.json; src/data/trainer_parties.h; src/data/trade.h; data/maps/</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Conditional</Data></Cell><Cell><Data ss:Type="String">Check for species-specific gameplay logic if the design requires a special mechanic.</Data></Cell><Cell><Data ss:Type="String">src/</Data></Cell><Cell><Data ss:Type="String">Usually unnecessary for ordinary stats, types, abilities, and evolution.</Data></Cell></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Validation</Data></Cell><Cell><Data ss:Type="String">Build the ROM and fix compile/link errors caused by missing IDs, table entries, or assets.</Data></Cell><Cell><Data ss:Type="String">Makefile</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Validation</Data></Cell><Cell><Data ss:Type="String">Test Pokedex data, front/back sprites, icon, cry, learnsets, evolution, and any intended encounter path in-game.</Data></Cell><Cell><Data ss:Type="String">In-game test</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Validation</Data></Cell><Cell><Data ss:Type="String">If National Dex count changed, audit count-dependent Pokedex and credits loops/buffers.</Data></Cell><Cell><Data ss:Type="String">src/pokedex.c; src/credits.c</Data></Cell><Cell/></Row>
      <Row><Cell><Data ss:Type="String">[ ]</Data></Cell><Cell><Data ss:Type="String">Validation</Data></Cell><Cell><Data ss:Type="String">Check save and link compatibility if IDs exceed existing storage or protocol assumptions.</Data></Cell><Cell><Data ss:Type="String">include/; src/</Data></Cell><Cell><Data ss:Type="String">Risk depends on the exact ID/count changes.</Data></Cell></Row>
    </Table>
    <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions>
  </Worksheet>
</Workbook>
